{
  "name": "social-platform-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "powershell -ExecutionPolicy Bypass -File ./scripts/bootstrap.ps1",
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "build:worker": "pnpm --filter task-worker build",
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "migrate": "powershell -ExecutionPolicy Bypass -File ./scripts/migrate.ps1",
    "verify:docs": "powershell -ExecutionPolicy Bypass -File ./scripts/verify-docs.ps1",
    "compose:up": "docker compose -f deploy/compose/docker-compose.yml up -d",
    "compose:down": "docker compose -f deploy/compose/docker-compose.yml down",
    "compose:config": "docker compose -f deploy/compose/docker-compose.yml config"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}