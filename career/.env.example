# =============================================================================
# Career / LinkedIn / Social Platform Environment Configuration (Example)
# Safe non-production defaults for local development and testing.
# Never commit real credentials or production secrets to source control.
# =============================================================================

# Server & Networking
PORT=8080
API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# PostgreSQL
POSTGRES_USER=social_user
POSTGRES_PASSWORD=social_dev_password
POSTGRES_DB=social_db
POSTGRES_PORT=5432
DATABASE_URL=postgres://social_user:social_dev_password@localhost:5432/social_db?sslmode=disable

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Meilisearch
MEILI_PORT=7700
MEILI_MASTER_KEY=social_dev_meili_master_key
MEILI_HOST=http://localhost:7700

# Private Object Storage (MinIO)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_dev_password
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minio_admin
STORAGE_SECRET_KEY=minio_dev_password
STORAGE_BUCKET_UPLOADS=social-uploads
STORAGE_BUCKET_EXPORTS=social-exports

# Security & JWT Authentication
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars
SESSION_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=30

# Mode & Safety Gates
ENVIRONMENT=development
SAFE_MODE=true
ENABLE_LIVE_SUBMISSIONS=false