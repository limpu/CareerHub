        "industries": ["Computer & Network Security"],
        "locations": ["Austin, TX"],
        "current_companies": ["SecureMesh"],
        "connection_tiers": ["1st"],
        "exclusions": ["Intern", "Junior"],
        "user_goal": "networking"
