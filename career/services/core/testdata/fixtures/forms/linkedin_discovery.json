{
  "description": "Groundtruth test fixtures for IMP-LI-05 professional people and company discovery",
  "scenarios": [
    {
      "scenario_id": "disc-eng-lead",
      "description": "Discovery of Distributed Systems Architects in San Francisco for recruiting",
      "criteria": {
        "target_role": "Distributed Systems Architect",
        "role_alternatives": ["Lead Systems Architect", "Principal Infrastructure Engineer"],
        "industries": ["Software Development", "Cloud Infrastructure"],
        "locations": ["San Francisco Bay Area", "Remote"],
        "current_companies": ["CloudScale Systems", "Apex Dynamics"],
        "connection_tiers": ["1st", "2nd"],
        "exclusions": ["Manager", "Director", "Sales"],
        "user_goal": "recruiting"
      },
      "expected_boolean_terms": [
        "(\"Distributed Systems Architect\" OR \"Lead Systems Architect\" OR \"Principal Infrastructure Engineer\")",
        "(\"CloudScale Systems\" OR \"Apex Dynamics\")",
        "NOT (\"Manager\" OR \"Director\" OR \"Sales\")"
      ]
    },
    {
