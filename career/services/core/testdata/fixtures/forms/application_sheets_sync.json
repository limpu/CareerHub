      "scenario_id": "formula_injection_defense",
      "description": "Verification that formula-like strings starting with =, +, -, @, \\t, \\r are safely escaped with single quote (AT-013).",
      "config": {
        "spreadsheet_id": "1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms",
        "sheet_name": "Job Applications",
        "timezone": "UTC",
        "sync_mode": "one_way_upsert",
        "include_notes": true
      },
      "input_applications": [
        {
          "id": "app-malicious-01",
          "title": "=cmd|'/C calc'!A0",
          "company": "@Financecorp",
          "location": "+Remote - North America",
          "portal_type": "generic_external",
          "stage": "applied",
          "is_verified_applied": false,
          "applied_at": "2026-09-17T10:00:00Z",
          "provider_reference": "-REF-999",
          "verification_type": "user_attestation",
          "notes": "\t=2+5*cmd|' /C powershell'!"
        }
      ],
      "existing_sheet_rows": [],
      "expected_sanitized_cells": [
        "'=cmd|'/C calc'!A0",
        "'@Financecorp",
        "'+Remote - North America",
        "'-REF-999",
        "'\t=2+5*cmd|' /C powershell'!"
      ]
