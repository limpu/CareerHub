    {
      "scenario_id": "human_resolution_and_audit_propagation",
      "description": "Candidate evaluates mismatch on job title, decides to retain_profile with justification; updates profile and records audit trail",
      "mismatch_id": "mis-title-fastfintech",
      "resolution_decision": {
        "action": "retain_profile",
        "chosen_value": "Lead Backend Architect",
        "user_justification": "Promoted to Lead Backend Architect in Q3 2023; canonical profile represents verified official title"
      },
      "expected_updated_title": "Lead Backend Architect",
      "expected_audit_trail_recorded": true
